# ── Claude (Anthropic) ──────────────────────────────────────────────
# Leave empty to use the built-in mock generator/reviewer.
# To use live models (Haiku generate + Sonnet ~15% sample review):
#   1. Create a key at https://console.anthropic.com/
#   2. Paste it below (never commit .env)
#   3. Restart API / docker compose
ANTHROPIC_API_KEY=
CLAUDE_MODEL_GENERATE=claude-haiku-4-5
CLAUDE_MODEL_RECOMMEND=claude-haiku-4-5
CLAUDE_MODEL_REVIEW=claude-sonnet-5-5
REVIEW_SAMPLE_RATE=0.15
MIN_POST_CHARS=2000

# ── Database / Redis ────────────────────────────────────────────────
# Docker Compose overrides these to Postgres + Redis service hostnames.
# Simple local-dev (no Docker): leave DATABASE_URL unset for SQLite, leave
# REDIS_URL empty to use in-process APScheduler.
# DATABASE_URL=postgresql+psycopg://autopost:autopost@localhost:5432/autopost
# REDIS_URL=redis://localhost:6379/0
# SCHEDULER_BACKEND=celery

# ── App ─────────────────────────────────────────────────────────────
SITE_PUBLIC_BASE_URL=http://127.0.0.1:3847
# Comma list, or * for open CORS (browser usually uses same-origin Next proxy)
CORS_ORIGINS=http://127.0.0.1:3847,http://localhost:3847
API_PORT=8471
BEAT_POLL_SECONDS=15
TIMEZONE=Asia/Seoul
ADMIN_TOKEN=dev-admin-token

# Next.js — leave NEXT_PUBLIC_API_BASE empty for same-origin /api rewrites (recommended)
NEXT_PUBLIC_API_BASE=
# SSR / rewrite target (docker bridge uses http://api:8471 via compose build args)
# API_INTERNAL_BASE=http://127.0.0.1:8471
